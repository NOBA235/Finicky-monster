{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "fickey-monster",
  "permissions": {
    "redis": true,
    "journeys": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_POST", "SUBMIT_COMMENT"]
    }
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post Today's Daily FINICKY",
        "description": "Create today's official FINICKY daily monster puzzle post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-daily"
      },
      {
        "label": "Post FINICKY Hub",
        "description": "Create a living FINICKY post that always opens today's monster",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-hub"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
